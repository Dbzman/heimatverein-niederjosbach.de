# Local config for the Makefile. Copy to .env and fill in:
#   cp .env.example .env
# .env is gitignored — never commit real credentials.
# This file is sourced by the shell, so quote values containing spaces,
# $, # or other special characters with single quotes.

# Local folder with the original photos, structured as <year>/<event>/*.jpg
GALLERY_SOURCE=~/Pictures/heimatverein-galerien

# SFTP access to the webserver (used by `make gallery-push`)
FTP_HOST=
FTP_USER=
FTP_PASS=''

# Target directory on the server, relative to the SFTP login directory
FTP_REMOTE_DIR=images/galerie
